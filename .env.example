# Application
DEBUG=True
SECRET_KEY=your-secret-key-replace-in-production-min-32-chars
# 초기 관리자(admin) 비밀번호: admin 계정이 없을 때만 사용 (8자 이상, 문자+숫자)
ADMIN_INITIAL_PASSWORD=
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Google Gemini API
GOOGLE_API_KEY=your-google-api-key-here

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Set true only after invite-code retention/backup review; default app startup
# does not destroy the legacy audit table.
DROP_LEGACY_INVITE_CODES_TABLE=false

# File Search
FS_MAIN_STORE_NAME=main-store
# 평가기준 스토어의 표시 이름. 앱은 이 이름과 정확히 같은 스토어만 쓴다.
# 운영이 아닌 배포(개발·E2E)는 반드시 다른 이름을 준다 (예: dev-rubric-store).
# 가능하면 GOOGLE_API_KEY도 운영과 나눈다. README "환경 변수" 참고.
FS_RUBRIC_STORE_NAME=rubric-store

# File Search 청킹 설정
FS_CHUNKING_MAX_TOKENS=1000
FS_CHUNKING_OVERLAP_TOKENS=100

# File Search 업로드 설정
FS_UPLOAD_TIMEOUT=300
FS_POLL_INTERVAL=5

# QnA 설정
QNA_TEMPERATURE=0.7
QNA_ENABLE_CITATIONS=true

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./data/uploads

# Models
GEMINI_QNA_MODEL=gemini-3.1-flash-lite
GEMINI_EVAL_MODEL=gemini-3.1-flash-lite
GEMINI_SIM_MODEL=gemini-3.1-flash-lite

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-cloud-key.json
GOOGLE_PROJECT_ID=your-google-project-id

# Vector DB Paths (Criteria vs User separation)
CRITERIA_VECTOR_DB_PATH=./data/vector_db/criteria/
USER_VECTOR_DB_PATH=./data/vector_db/user/

# Criteria Upload
CRITERIA_UPLOAD_DIR=./data/uploads/criteria/

# Application
DEBUG=True
SECRET_KEY=your-secret-key-replace-in-production-min-32-chars
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Google Gemini API
GOOGLE_API_KEY=your-google-api-key-here

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# File Search
FS_MAIN_STORE_NAME=main-store
FS_RUBRIC_STORE_NAME=rubric-store

# File Search 청킹 설정
FS_CHUNKING_MAX_TOKENS=1000
FS_CHUNKING_OVERLAP_TOKENS=100

# File Search 업로드 설정
FS_UPLOAD_TIMEOUT=300
FS_POLL_INTERVAL=5

# QnA 설정
QNA_TEMPERATURE=0.7
QNA_ENABLE_CITATIONS=true

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./data/uploads

# Models
GEMINI_QNA_MODEL=gemini-2.0-flash-exp
GEMINI_EVAL_MODEL=gemini-2.0-flash-thinking-exp

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-cloud-key.json
GOOGLE_PROJECT_ID=your-google-project-id

# Vector DB Paths (Criteria vs User separation)
CRITERIA_VECTOR_DB_PATH=./data/vector_db/criteria/
USER_VECTOR_DB_PATH=./data/vector_db/user/

# Criteria Upload
CRITERIA_UPLOAD_DIR=./data/uploads/criteria/
